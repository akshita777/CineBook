# =================================================================
# Ticket Booking System - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment
# =================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DATABASE_NAME=ticket_booking_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/ticket_booking_db

# Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis Distributed Lock Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=notification-service-group

# Security & Authentication (JWT)
# Must be at least 256 bits (32+ characters) for HS256 algorithm
JWT_SECRET=ticketBookingSystemSecureJwtSecretKeyMustBeAtLeast256BitsLong2026
JWT_EXPIRATION_MS=86400000

# Business Logic Configuration
# Temporary seat lock TTL in seconds (default 5 minutes = 300s)
SEAT_LOCK_TTL_SECONDS=300

# JPA / Hibernate
HIBERNATE_DDL_AUTO=update
